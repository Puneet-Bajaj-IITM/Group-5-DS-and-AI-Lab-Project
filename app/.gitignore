# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Older Flutter/Pub files
.flutter-plugins
.packages
.pub-cache/

# Flutter Version Manager
.fvm/

# Local secrets and signing (never commit these)
.env
.env.*
*.keystore
*.jks
*.p12
*.mobileprovision
android/key.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Build outputs and local tooling
*.apk
*.aab
/assets/models/*
!/assets/models/README.md
*.ipa
